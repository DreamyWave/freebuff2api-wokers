# freebuff2api-workers 环境变量示例
# 复制为 .dev.vars 用于本地 wrangler dev，或部署后在 CF 后台 Secrets 配置

# freebuff authToken（多账号逗号分隔，额度撞墙自动切下一个）
FREEBUFF_TOKEN=your-freebuff-token

# freebuff 用户 id（freebuff_credentials.json 里的 id 字段，可选）
# 会作为 x-freebuff-acting-user-id 头传给上游，更贴近官方 CLI
FREEBUFF_USER_ID=your-freebuff-user-id

# 本 API 访问 key（可选，缺省用 freebuff-default-key）
FREEBUFF_API_KEY=sk-your-key

# 调试（可选）
FREEBUFF_DEBUG=false
